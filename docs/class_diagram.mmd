classDiagram
    class User {
        +int id
        +string username
        +string email
        +string passwordHash
        +string companyName
        +string companyEmail
        +Role role
        +UserStatus status
        +string suspensionReason
        +boolean hasUsedFreeTrial
        +string stripeCustomerId
        +datetime createdAt
        +datetime updatedAt
        +register(email: string, password: string) User
        +validatePassword(password: string) boolean
        +updateProfile(data: object) void
        +suspend(reason: string) void
        +reactivate() void
        +deleteAccount() void
    }

    class Plan {
        +int id
        +string name
        +decimal price
        +int maxStorageMb
        +int durationDays
        +string stripeProductId
        +string stripePriceId
        +PlanStatus status
        +datetime createdAt
        +datetime updatedAt
        +create(data: object) Plan
        +update(data: object) Plan
        +activate() void
        +deactivate() void
        +delete() void
    }

    class ActiveSubscription {
        +int id
        +int userId
        +int planId
        +datetime startDate
        +datetime endDate
        +string stripeSubscriptionId
        +datetime currentPeriodEnd
        +decimal usedStorageMb
        +SubscriptionStatus status
        +datetime createdAt
        +datetime updatedAt
        +create(userId: int, planId: int) ActiveSubscription
        +cancel() void
        +syncWithStripe() void
        +hasStorageAvailable(requiredMb: decimal) boolean
        +updateStorageUsage(mb: decimal) void
    }

    class Dataset {
        +int id
        +int userId
        +string filename
        +string filePath
        +decimal fileSizeMb
        +DatasetStatus status
        +int totalReviews
        +int processedReviews
        +string errorMessage
        +datetime createdAt
        +datetime updatedAt
        +upload(file: File) Dataset
        +startAnalysis() void
        +retryAnalysis() void
        +delete() void
    }

    class Review {
        +int id
        +int datasetId
        +string productName
        +string reviewText
        +datetime createdAt
        +create(datasetId: int, text: string) Review
        +getAspects() array
    }

    class FeedbackResult {
        +int id
        +int reviewId
        +string aspect
        +string opinion
        +string sentiment
        +datetime createdAt
        +saveResult(aspect: string, sentiment: string) void
    }

    class VerificationCode {
        +int id
        +int userId
        +string codeHash
        +string resetTokenHash
        +datetime expiresAt
        +datetime createdAt
        +generateCode(userId: int) string
        +verify(code: string) boolean
        +isExpired() boolean
    }

    class Feedback {
        +int feedbackId
        +int retailerId
        +string subject
        +string message
        +FeedbackStatus status
        +int repliedBy
        +datetime deletedAt
        +datetime createdAt
        +submit(retailerId: int, message: string) Feedback
        +reply(adminId: int, replyText: string) void
        +updateStatus(status: FeedbackStatus) void
        +softDelete() void
    }

    class FAQ {
        +int faqId
        +string question
        +string answer
        +boolean isVisible
        +int sortOrder
        +datetime createdAt
        +datetime updatedAt
        +create(question: string, answer: string) FAQ
        +update(question: string, answer: string) void
        +toggleVisibility() void
        +delete() void
    }

    class PlanAnnouncement {
        +int announcementId
        +int planId
        +string action
        +string title
        +string message
        +array targetUserIds
        +datetime createdAt
        +createAnnouncement(planId: int, message: string) PlanAnnouncement
        +getTargetUsers() array
    }

    class UserAnnouncementView {
        +int userId
        +int announcementId
        +datetime seenAt
        +markAsSeen(userId: int, announcementId: int) void
    }

    class Policy {
        +int id
        +string type
        +string title
        +string content
        +string version
        +int updatedBy
        +datetime createdAt
        +datetime updatedAt
        +getLatestVersion(type: string) Policy
        +updatePolicy(content: string, updatedBy: int) void
    }

    class Role {
        <<enumeration>>
        ADMIN
        RETAIL_MANAGER
    }

    class UserStatus {
        <<enumeration>>
        active
        suspended
        deleted
    }

    class SubscriptionStatus {
        <<enumeration>>
        ACTIVE
        EXPIRED
        INCOMPLETE
        PAST_DUE
        CANCELED
        TRIALING
    }

    class PlanStatus {
        <<enumeration>>
        ACTIVE
        INACTIVE
    }

    class DatasetStatus {
        <<enumeration>>
        PENDING
        ANALYSIS_IN_PROGRESS
        COMPLETED
        FAILED
    }

    class FeedbackStatus {
        <<enumeration>>
        pending
        sent
        replied
    }

    User --> Role : has
    User --> UserStatus : has
    Plan --> PlanStatus : has
    ActiveSubscription --> SubscriptionStatus : has
    Dataset --> DatasetStatus : has
    Feedback --> FeedbackStatus : has

    User "1" --> "*" ActiveSubscription : subscribes
    Plan "1" --> "*" ActiveSubscription : defines

    User "1" --> "*" Dataset : uploads
    Dataset "1" *-- "*" Review : contains
    Review "1" *-- "*" FeedbackResult : yields

    User "1" --> "*" VerificationCode : requests

    User "1" --> "*" Feedback : submits
    User "0..1" --> "*" Feedback : replies

    Plan "0..1" --> "*" PlanAnnouncement : targets
    User "1" --> "*" UserAnnouncementView : views
    PlanAnnouncement "1" --> "*" UserAnnouncementView : tracks

    User "0..1" --> "*" Policy : updates
