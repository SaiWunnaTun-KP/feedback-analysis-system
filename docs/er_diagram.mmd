erDiagram
    users ||--o{ active_subscriptions : "subscribes"
    plans ||--o{ active_subscriptions : "defines"
    users ||--o{ datasets : "uploads"
    datasets ||--o{ reviews : "contains"
    reviews ||--o{ feedback_results : "yields"
    users ||--o{ verification_codes : "requests"
    users ||--o{ feedbacks : "creates"
    users ||--o{ feedbacks : "replies_to"
    plans ||--o{ plan_announcements : "announces"
    users ||--o{ user_announcement_views : "views"
    plan_announcements ||--o{ user_announcement_views : "tracks"
    users ||--o{ policies : "updates"

    users {
        int id PK
        string username
        string email
        string password
        string company_name
        string company_email
        string role
        string status
        string suspension_reason
        boolean has_used_free_trial
        string stripe_customer_id
        timestamp created_at
        timestamp updated_at
    }

    plans {
        int id PK
        string name
        numeric price
        int max_storage_mb
        int duration_days
        string stripe_product_id
        string stripe_price_id
        string status
        timestamp created_at
        timestamp updated_at
    }

    active_subscriptions {
        int id PK
        int user_id FK
        int plan_id FK
        timestamp start_date
        timestamp end_date
        string stripe_subscription_id
        timestamp current_period_end
        numeric used_storage_mb
        string status
        timestamp created_at
        timestamp updated_at
    }

    datasets {
        int id PK
        int user_id FK
        string filename
        string file_path
        numeric file_size_mb
        string status
        int total_reviews
        int processed_reviews
        string error_message
        timestamp created_at
        timestamp updated_at
    }

    reviews {
        int id PK
        int dataset_id FK
        string product_name
        string review_text
        timestamp created_at
    }

    feedback_results {
        int id PK
        int review_id FK
        string aspect
        string opinion
        string sentiment
        timestamp created_at
    }

    verification_codes {
        int id PK
        int user_id FK
        string code_hash
        string reset_token_hash
        timestamp expires_at
        timestamp created_at
    }

    feedbacks {
        int feedback_id PK
        int retailer_id FK
        string subject
        string message
        string status
        int replied_by FK
        timestamp deleted_at
        timestamp created_at
    }

    faqs {
        int faq_id PK
        string question
        string answer
        boolean is_visible
        int sort_order
        timestamp created_at
        timestamp updated_at
    }

    plan_announcements {
        int announcement_id PK
        int plan_id FK
        string action
        string title
        string message
        timestamp created_at
    }

    user_announcement_views {
        int user_id PK_FK
        int announcement_id PK_FK
        timestamp seen_at
    }

    policies {
        int id PK
        string type
        string title
        string content
        string version
        int updated_by FK
        timestamp created_at
        timestamp updated_at
    }

